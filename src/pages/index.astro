---
import DaysCounterIsland from "../components/DaysCounterIsland";
import { calculateDaysSince, getArgentinaDate } from "../lib/days-counter";

const coudetDayOne = "2026-03-05";
const coudetDayOneLabel = "5 de marzo de 2026";
const argentinaToday = getArgentinaDate();

const daysInCharge = calculateDaysSince(coudetDayOne, argentinaToday);
const daysLabel = daysInCharge === 1 ? "1 día" : `${daysInCharge} días`;
const answerSentence = `Coudet lleva ${daysLabel} en River, contando desde el ${coudetDayOneLabel}.`;

const siteName = "Coudet River";
const pageTitle = "Hace cuánto está Coudet en River hoy | Días del Chacho en River";
const pageDescription =
  `${answerSentence} Contador actualizado todos los días con cuánto tiempo lleva el Chacho en el cargo en River Plate.`;
const pageImage = "https://www.canal12misiones.com/wp-content/uploads/2026/02/Chacho-1.jpg";
const secretImage = "https://www.ole.com.ar/images/2010/04/13/BJQLTgq--_720x0.jpg";
const canonicalUrl = "https://coudetenriver.site/";
const pageKeywords =
  "hace cuanto esta coudet en river, hace cuánto está coudet, cuanto tiempo lleva coudet en river, desde cuando esta coudet en river, cuantos dias lleva coudet, contador coudet river, días de coudet en river";
const isoPublishedTime = `${coudetDayOne}T00:00:00-03:00`;
const isoModifiedTime = `${argentinaToday}T00:00:00-03:00`;
const faqItems = [
  {
    question: "¿Hace cuánto está Coudet en River?",
    answer: `${answerSentence} El contador suma un día por cada nueva fecha del calendario.`
  },
  {
    question: "¿Cuántos días lleva Coudet en River?",
    answer: `Lleva ${daysLabel} al día de hoy, tomando el ${coudetDayOneLabel} como día 1 del ciclo.`
  },
  {
    question: "¿Desde cuándo está Coudet en River?",
    answer: `Desde el ${coudetDayOneLabel}, fecha que este contador considera el primer día de su ciclo en River Plate.`
  },
  {
    question: "¿Cada cuánto se actualiza el número de días?",
    answer: "Se actualiza todos los días y suma una unidad por cada nueva fecha calendario."
  },
  {
    question: "¿Qué muestra exactamente este sitio?",
    answer: "Muestra un contador simple de días transcurridos desde el inicio del ciclo de Eduardo Coudet en River Plate."
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#0d0e12" />
    <link rel="icon" type="image/png" href="https://upload.wikimedia.org/wikipedia/commons/a/a8/Escudo-River-1930.png" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-AR" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:secure_url" content={pageImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Eduardo Chacho Coudet en una imagen de actualidad" />
    <meta property="article:published_time" content={isoPublishedTime} />
    <meta property="article:modified_time" content={isoModifiedTime} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content="Eduardo Chacho Coudet en River Plate" />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            name: siteName,
            url: canonicalUrl,
            inLanguage: "es-AR"
          },
          {
            "@type": "WebPage",
            name: pageTitle,
            description: pageDescription,
            url: canonicalUrl,
            inLanguage: "es-AR",
            datePublished: isoPublishedTime,
            dateModified: isoModifiedTime,
            isPartOf: {
              "@type": "WebSite",
              name: siteName,
              url: canonicalUrl
            },
            keywords: pageKeywords,
            author: {
              "@type": "Person",
              name: "Ignadev",
              url: "https://github.com/NachoBasilio"
            },
            speakable: {
              "@type": "SpeakableSpecification",
              cssSelector: ["h1", ".answer"]
            },
            about: {
              "@type": "Person",
              name: "Eduardo Coudet",
              alternateName: "Chacho Coudet"
            },
            mainEntity: {
              "@type": "SportsTeam",
              name: "River Plate"
            }
          },
          {
            "@type": "FAQPage",
            inLanguage: "es-AR",
            mainEntity: faqItems.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: {
                "@type": "Answer",
                text: item.answer
              }
            }))
          }
        ]
      })}
    </script>
    <style>
      :root {
        --river-red: #e2172c;
        --river-red-deep: #a80d1c;
        --bg: #0d0e12;
        --surface: rgba(255, 255, 255, 0.045);
        --surface-strong: rgba(255, 255, 255, 0.07);
        --border: rgba(255, 255, 255, 0.1);
        --text: #f2f3f5;
        --text-muted: #a7abb4;
        --radius: 18px;
        --shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        padding: clamp(1.5rem, 5vw, 3.5rem) 1rem calc(5.5rem + env(safe-area-inset-bottom));
        display: grid;
        place-items: start center;
        font-family: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", sans-serif;
        background-color: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      /* River's diagonal "banda" as an ambient backdrop. */
      body::before {
        content: "";
        position: fixed;
        inset: -20%;
        z-index: -1;
        background:
          radial-gradient(60% 50% at 50% 0%, rgba(226, 23, 44, 0.22) 0%, transparent 70%),
          linear-gradient(
            118deg,
            transparent 0 44%,
            rgba(226, 23, 44, 0.13) 44% 56%,
            transparent 56% 100%
          );
        pointer-events: none;
      }

      main {
        width: min(94vw, 720px);
        display: grid;
        gap: clamp(1.1rem, 3vw, 1.6rem);
        justify-items: center;
        text-align: center;
      }

      .eyebrow {
        margin: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.4rem 0.95rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .eyebrow::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--river-red);
        box-shadow: 0 0 0 4px rgba(226, 23, 44, 0.22);
      }

      h1 {
        margin: 0;
        font-size: clamp(1.9rem, 6.2vw, 3.1rem);
        line-height: 1.06;
        letter-spacing: -0.03em;
        text-wrap: balance;
      }

      .image-wrap {
        position: relative;
        margin: 0;
        width: 100%;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .image-wrap img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: 50% 28%;
        filter: grayscale(1) contrast(1.14) brightness(0.92);
      }

      .image-wrap::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            130deg,
            rgba(226, 23, 44, 0.4) 0%,
            rgba(226, 23, 44, 0.05) 48%,
            transparent 100%
          ),
          linear-gradient(to top, rgba(13, 14, 18, 0.85) 0%, transparent 55%);
        pointer-events: none;
      }

      .card {
        width: 100%;
        padding: clamp(1.2rem, 4vw, 1.9rem);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        backdrop-filter: blur(10px);
      }

      .counter-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, var(--surface-strong), var(--surface));
        box-shadow: var(--shadow);
      }

      .counter-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--river-red), transparent);
      }

      .counter-since {
        margin: 0.9rem 0 0;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .counter-since strong {
        color: var(--text);
        font-weight: 600;
      }

      :global(.counter) {
        margin: 0;
        text-align: center;
        line-height: 1.2;
      }

      :global(.counter strong) {
        display: block;
        font-size: clamp(4rem, 19vw, 7.5rem);
        font-weight: 800;
        line-height: 0.92;
        letter-spacing: -0.05em;
        font-variant-numeric: tabular-nums;
        background: linear-gradient(180deg, #ff4b5e, var(--river-red-deep));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      :global(.counter span) {
        display: block;
        margin-top: 0.55rem;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .answer {
        margin: 0;
        max-width: 46ch;
        font-size: clamp(1.05rem, 3vw, 1.25rem);
        line-height: 1.5;
        color: var(--text);
        text-wrap: balance;
      }

      .answer strong {
        color: #ff5c6d;
        font-weight: 700;
        white-space: nowrap;
      }

      .intro {
        margin: 0;
        max-width: 62ch;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text-muted);
      }

      .secondary-query {
        text-align: left;
      }

      .secondary-query h2 {
        margin: 0 0 0.6rem;
        font-size: clamp(1.15rem, 3vw, 1.4rem);
        letter-spacing: -0.015em;
      }

      .secondary-query p {
        margin: 0;
        line-height: 1.6;
        color: var(--text-muted);
      }

      .faq {
        width: 100%;
        text-align: left;
      }

      .faq h2 {
        margin: 0 0 0.9rem;
        font-size: clamp(1.2rem, 3.2vw, 1.5rem);
        letter-spacing: -0.015em;
      }

      .faq-list {
        display: grid;
        gap: 0.55rem;
      }

      .faq details {
        border: 1px solid var(--border);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        transition: border-color 0.2s ease;
      }

      .faq details[open] {
        border-color: rgba(226, 23, 44, 0.45);
      }

      .faq summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 1rem;
        font-weight: 600;
        cursor: pointer;
        list-style: none;
      }

      .faq summary::-webkit-details-marker {
        display: none;
      }

      .faq summary::after {
        content: "+";
        flex: none;
        font-size: 1.25rem;
        line-height: 1;
        color: var(--river-red);
        transition: transform 0.2s ease;
      }

      .faq details[open] summary::after {
        transform: rotate(45deg);
      }

      .faq p {
        margin: 0;
        padding: 0 1rem 0.95rem;
        line-height: 1.6;
        color: var(--text-muted);
      }

      .site-footer {
        margin: 0;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(167, 171, 180, 0.6);
      }

      .site-footer a {
        color: var(--text-muted);
        text-decoration-color: rgba(226, 23, 44, 0.6);
        text-underline-offset: 3px;
      }

      .site-footer a:hover,
      .site-footer a:focus-visible {
        color: var(--river-red);
      }

      /* Floating help trigger + photo dialog */
      .help-trigger {
        position: fixed;
        right: clamp(1rem, 4vw, 2rem);
        bottom: calc(clamp(1rem, 4vw, 2rem) + env(safe-area-inset-bottom));
        z-index: 10;
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        background: linear-gradient(180deg, var(--river-red), var(--river-red-deep));
        color: #fff;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 12px 30px rgba(226, 23, 44, 0.4);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }

      .help-trigger:hover,
      .help-trigger:focus-visible {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 18px 38px rgba(226, 23, 44, 0.55);
      }

      .photo-dialog {
        width: min(92vw, 720px);
        padding: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: #14161c;
        color: var(--text);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .photo-dialog::backdrop {
        background: rgba(6, 7, 10, 0.78);
        backdrop-filter: blur(4px);
      }

      .photo-dialog[open] {
        animation: dialog-in 0.22s ease-out;
      }

      .photo-dialog img {
        display: block;
        width: 100%;
        height: auto;
      }

      .photo-dialog figure {
        margin: 0;
      }

      .photo-dialog figcaption {
        padding: 0.85rem 1.1rem 1.1rem;
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--text-muted);
      }

      .dialog-close {
        position: absolute;
        top: 0.7rem;
        right: 0.7rem;
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 50%;
        background: rgba(13, 14, 18, 0.72);
        color: #fff;
        font-size: 1.1rem;
        line-height: 1;
        cursor: pointer;
        backdrop-filter: blur(6px);
      }

      .dialog-close:hover,
      .dialog-close:focus-visible {
        background: var(--river-red);
      }

      :focus-visible {
        outline: 2px solid var(--river-red);
        outline-offset: 3px;
      }

      @keyframes dialog-in {
        from {
          opacity: 0;
          transform: translateY(12px) scale(0.97);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p class="eyebrow">River Plate · Ciclo Coudet</p>

      <h1>Hace cuánto está Coudet en River</h1>

      <!-- Direct answer in server-rendered HTML: this is what search snippets quote. -->
      <p class="answer">
        Coudet lleva <strong>{daysLabel}</strong> en River, contando desde el {coudetDayOneLabel}.
      </p>

      <figure class="image-wrap">
        <img
          src={pageImage}
          alt="Eduardo Chacho Coudet, posible candidato para dirigir a River Plate"
          loading="eager"
        />
      </figure>

      <section class="card counter-card" aria-label="Días de Coudet en River">
        <DaysCounterIsland client:load startDate={coudetDayOne} initialValue={daysInCharge} />
        <p class="counter-since">Desde el <strong>{coudetDayOneLabel}</strong></p>
      </section>

      <p class="intro">
        Este contador muestra cuántos días pasaron desde el inicio del ciclo de Eduardo Chacho Coudet en River Plate.
        Se actualiza a diario para responder rápido búsquedas como: hace cuánto está Coudet en River o cuánto tiempo lleva el Chacho en el cargo.
      </p>

      <section class="card secondary-query" aria-labelledby="secondary-query-title">
        <h2 id="secondary-query-title">¿Desde cuándo está Coudet en River?</h2>
        <p>
          Coudet está en River desde el {coudetDayOneLabel}, es decir hace {daysLabel}.
          El conteo toma esa fecha como día 1 y suma una unidad por cada nueva fecha del calendario.
        </p>
      </section>

      <section class="card secondary-query" aria-labelledby="how-long-title">
        <h2 id="how-long-title">¿Cuánto tiempo lleva el Chacho en el cargo?</h2>
        <p>
          Al día de hoy, {daysLabel} al frente del plantel de River Plate.
          Si buscaste “hace cuánto está Coudet”, “cuántos días lleva Coudet en River” o
          “desde cuándo dirige el Chacho”, la respuesta es la misma: {daysLabel}.
        </p>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Preguntas frecuentes</h2>
        <div class="faq-list">
          {faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <p class="site-footer">
        Contador no oficial · Hincha data · Hecha por
        <a href="https://github.com/NachoBasilio" target="_blank" rel="noopener author">Ignadev</a>
      </p>
    </main>

    <button type="button" class="help-trigger" aria-label="Ver la foto" data-open-photo>?</button>

    <dialog class="photo-dialog" data-photo-dialog aria-label="Foto de archivo">
      <button type="button" class="dialog-close" aria-label="Cerrar" data-close-photo>✕</button>
      <figure>
        <img src={secretImage} alt="Foto de archivo de Olé, 13 de abril de 2010" loading="lazy" />
        <figcaption>Foto de archivo — Olé, 13 de abril de 2010.</figcaption>
      </figure>
    </dialog>

    <script>
      const dialog = document.querySelector("[data-photo-dialog]");
      const openButton = document.querySelector("[data-open-photo]");
      const closeButton = document.querySelector("[data-close-photo]");

      openButton?.addEventListener("click", () => dialog?.showModal());
      closeButton?.addEventListener("click", () => dialog?.close());

      // Clicking the backdrop resolves to the dialog element itself.
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    </script>
  </body>
</html>
