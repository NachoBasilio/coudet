---
const coudetDayOne = "2026-03-05";
const millisecondsPerDay = 86400000;
const today = new Date();

const startDate = new Date(`${coudetDayOne}T00:00:00`);
const currentDate = new Date(today.getFullYear(), today.getMonth(), today.getDate());
const elapsedDays = Math.floor((currentDate.getTime() - startDate.getTime()) / millisecondsPerDay);
const counterValue = String(Math.max(1, elapsedDays + 1));
const siteName = "Coudet River";
const pageTitle = "Cuanto tiempo lleva el Chacho en River | Coudet River";
const pageDescription =
  "Segui en vivo cuantos dias lleva Eduardo Chacho Coudet en River Plate con contador diario actualizado y contexto rapido de su ciclo.";
const pageImage = "https://www.canal12misiones.com/wp-content/uploads/2026/02/Chacho-1.jpg";
const canonicalUrl = "https://coudet-river.vercel.app/";
const pageKeywords =
  "cuanto tiempo lleva el chacho en river, contador coudet river, eduardo coudet river, chacho coudet river plate, dias de coudet en river";
const isoPublishedTime = `${coudetDayOne}T00:00:00-03:00`;
const isoModifiedTime = `${currentDate.toISOString().split("T")[0]}T00:00:00-03:00`;
const faqItems = [
  {
    question: "Desde cuando arranca este contador de Coudet en River?",
    answer: "El conteo arranca en 1 desde el 2026-03-05, considerado como dia 1 del ciclo."
  },
  {
    question: "Cada cuanto se actualiza el numero de dias?",
    answer: "Se actualiza todos los dias y suma una unidad por cada nueva fecha calendario."
  },
  {
    question: "Que muestra exactamente este sitio?",
    answer: "Muestra un contador simple de dias transcurridos desde el inicio del ciclo de Eduardo Coudet en River Plate."
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#d90f1f" />
    <link rel="icon" type="image/png" href="https://upload.wikimedia.org/wikipedia/commons/a/a8/Escudo-River-1930.png" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-AR" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:secure_url" content={pageImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Eduardo Chacho Coudet en una imagen de actualidad" />
    <meta property="article:published_time" content={isoPublishedTime} />
    <meta property="article:modified_time" content={isoModifiedTime} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content="Eduardo Chacho Coudet en River Plate" />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            name: siteName,
            url: canonicalUrl,
            inLanguage: "es-AR"
          },
          {
            "@type": "WebPage",
            name: pageTitle,
            description: pageDescription,
            url: canonicalUrl,
            inLanguage: "es-AR",
            datePublished: isoPublishedTime,
            dateModified: isoModifiedTime,
            isPartOf: {
              "@type": "WebSite",
              name: siteName,
              url: canonicalUrl
            },
            keywords: pageKeywords,
            about: {
              "@type": "Person",
              name: "Eduardo Coudet",
              alternateName: "Chacho Coudet"
            },
            mainEntity: {
              "@type": "SportsTeam",
              name: "River Plate"
            }
          },
          {
            "@type": "FAQPage",
            inLanguage: "es-AR",
            mainEntity: faqItems.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: {
                "@type": "Answer",
                text: item.answer
              }
            }))
          }
        ]
      })}
    </script>
    <style>
      :root {
        --river-red: #d90f1f;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: "Trebuchet MS", "Segoe UI", sans-serif;
        background: linear-gradient(165deg, #f8f8f8 0%, #ececec 100%);
        color: #1d1d1d;
      }

      main {
        width: min(92vw, 760px);
        display: grid;
        gap: 1.2rem;
        justify-items: center;
        text-align: center;
      }

      h1 {
        margin: 0;
        font-size: clamp(1.8rem, 5.4vw, 2.7rem);
        line-height: 1.12;
        letter-spacing: -0.02em;
        text-wrap: balance;
      }

      .image-wrap {
        position: relative;
        margin: 0;
        border: 8px solid var(--white);
        outline: 4px solid var(--river-red);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
        overflow: hidden;
      }

      .image-wrap img {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(1) contrast(1.12) brightness(0.98) saturate(0);
      }

      .image-wrap::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            130deg,
            rgba(217, 15, 31, 0.35) 0%,
            rgba(217, 15, 31, 0.08) 44%,
            rgba(255, 255, 255, 0.18) 100%
          );
        pointer-events: none;
      }

      .counter {
        text-align: center;
        line-height: 1.3;
      }

      .counter strong {
        display: block;
        font-size: clamp(2rem, 6vw, 2.6rem);
        color: var(--river-red);
      }

      .counter span {
        font-size: 1.05rem;
      }

      .intro {
        margin: 0;
        max-width: 62ch;
        font-size: 1rem;
        line-height: 1.5;
      }

      .faq {
        width: 100%;
        max-width: 62ch;
        text-align: left;
      }

      .faq h2 {
        margin: 0 0 0.7rem;
        font-size: clamp(1.2rem, 3.2vw, 1.5rem);
      }

      .faq ul {
        margin: 0;
        padding-left: 1.15rem;
        display: grid;
        gap: 0.7rem;
      }

      .faq li {
        line-height: 1.45;
      }

      .faq strong {
        color: #121212;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>CUANTO TIEMPO LLEVA EL CHACHO EN RIVER</h1>

      <figure class="image-wrap">
        <img
          src={pageImage}
          alt="Eduardo Chacho Coudet, posible candidato para dirigir a River Plate"
          loading="eager"
        />
      </figure>

      <p class="counter">
        <strong>{counterValue}</strong>
        <span>Dias desde el primer dia de Coudet</span>
      </p>

      <p class="intro">
        Este contador muestra cuantos dias pasaron desde el inicio del ciclo de Eduardo Chacho Coudet en River Plate.
        Se actualiza a diario para responder rapido la consulta: cuanto tiempo lleva Coudet en River.
      </p>

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Preguntas frecuentes</h2>
        <ul>
          {faqItems.map((item) => (
            <li>
              <strong>{item.question}</strong> {item.answer}
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
